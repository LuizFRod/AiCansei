# Copie este arquivo para .env e preencha os valores (veja o README.md)

# Banco de dados (PostgreSQL/Supabase)
# URL usada pela aplicação (Supabase: Transaction pooler, porta 6543)
DATABASE_URL="postgresql://postgres.<SEU-PROJETO>:<SUA-SENHA>@<HOST-DO-POOLER>:6543/postgres?pgbouncer=true"
# URL direta do mesmo banco, usada pelo Prisma (Supabase: Direct connection, porta 5432)
DIRECT_URL="postgresql://postgres:<SUA-SENHA>@db.<SEU-PROJETO>.supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Obrigatório: pelo menos 16 caracteres (o README mostra como gerar)
NEXTAUTH_SECRET=""

# Cloudinary (upload de fotos dos anúncios)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (opcional — sem a chave, o conteúdo dos e-mails aparece no terminal)
RESEND_API_KEY=""
EMAIL_FROM=""

# Cloudflare Turnstile (opcional — sem as chaves, usa captcha matemático próprio)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
