# Banco de dados (Supabase/PostgreSQL)
# Conexão pooled para a aplicação (use os dados fornecidos pelo seu provedor)
DATABASE_URL="postgresql://postgres:password@db.<SEU-PROJETO>.supabase.co:5432/postgres?pgbouncer=true&connect_timeout=15&sslmode=require"
# Conexão direta do mesmo banco, usada pelo Prisma
DIRECT_URL="postgresql://postgres:password@db.<SEU-PROJETO>.supabase.co:5432/postgres?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (upload de imagens)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare Turnstile (opcional — sem as chaves, usa captcha matemático próprio)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
